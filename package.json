{
  "name": "eshop",
  "version": "2.0.0",
  "private": true,
  "description": "eShop full-stack commerce app",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedaboseada/eShop.git"
  },
  "author": "Ahmed Abu Seada",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
